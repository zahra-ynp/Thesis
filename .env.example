# External APIs
FRED_API_KEY=replace-with-your-fred-api-key
NYT_API_KEY=replace-with-your-nyt-api-key

# SQL Server connection
DB_SERVER=replace-with-your-sql-server
DB_DATABASE=replace-with-your-database-name
DB_DRIVER=ODBC Driver 17 for SQL Server

# Use "trusted" for Windows authentication or "sql" for SQL authentication.
DB_AUTH_MODE=trusted
DB_TRUST_SERVER_CERTIFICATE=yes

# Required only when DB_AUTH_MODE=sql
DB_USERNAME=
DB_PASSWORD=
